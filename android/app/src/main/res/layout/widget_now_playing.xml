<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="8dp">

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/widget_art"
        android:contentDescription="@null"
        android:padding="11dp"
        android:src="@drawable/widget_note_light" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/now_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_nothing_playing"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/now_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_tap_to_open"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/now_previous"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/widget_previous"
        android:padding="8dp"
        android:src="@drawable/widget_previous" />

    <ImageView
        android:id="@+id/now_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/widget_play_pause"
        android:padding="9dp"
        android:src="@drawable/widget_play" />

    <ImageView
        android:id="@+id/now_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/widget_next"
        android:padding="8dp"
        android:src="@drawable/widget_next" />
</LinearLayout>
