<?xml version="1.0" encoding="utf-8"?>
<!-- Mini player, 2×1: a violet pill with play/pause, title and next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="6dp"
    android:paddingRight="8dp">

    <ImageView
        android:id="@+id/now_play"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_circle_light"
        android:contentDescription="@string/widget_play_pause"
        android:padding="8dp"
        android:src="@drawable/widget_play_accent" />

    <TextView
        android:id="@+id/now_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_nothing_playing"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/now_next"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@string/widget_next"
        android:padding="5dp"
        android:src="@drawable/widget_next_light" />
</LinearLayout>
