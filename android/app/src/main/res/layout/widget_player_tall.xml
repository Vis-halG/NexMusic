<?xml version="1.0" encoding="utf-8"?>
<!-- Tall player, 2×3: vertical violet card with centred art and controls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_gradient"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/now_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:text="@string/widget_status_idle"
        android:textAllCaps="true"
        android:textColor="#CCFFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_translucent_circle">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/widget_note_light" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/now_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/widget_nothing_playing"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/now_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_tap_to_open"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/now_previous"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/widget_previous"
            android:padding="7dp"
            android:src="@drawable/widget_previous_light" />

        <ImageView
            android:id="@+id/now_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/widget_circle_light"
            android:contentDescription="@string/widget_play_pause"
            android:padding="12dp"
            android:src="@drawable/widget_play_accent" />

        <ImageView
            android:id="@+id/now_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/widget_next"
            android:padding="7dp"
            android:src="@drawable/widget_next_light" />
    </LinearLayout>
</LinearLayout>
